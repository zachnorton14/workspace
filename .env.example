# Supabase → Connect → Session pooler (port 5432). Not the transaction pooler (6543): with postgres.js,
# queries that queue behind a busy connection there never complete.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres
# Used by drizzle-kit migrations; the same session pooler URL works
DATABASE_URL_DIRECT=postgresql://postgres.xxxx:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres
# Long random secret: `openssl rand -hex 32`. Used as the bearer token for agents/API and the web UI login.
WORKSPACE_API_TOKEN=
# Your timezone, used for "today" buckets
WORKSPACE_TIMEZONE=America/New_York

# Triage agent (Claude). Use a key dedicated to Workspace.
ANTHROPIC_API_KEY=
# Shared secret for the scheduler → /api/collect/* (`openssl rand -hex 32`)
CRON_SECRET=
# Discord app (Developer Portal → your app): General Information → Application ID / Public Key; Bot → Token
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Your own Discord user id (Settings → Advanced → Developer Mode, then right-click yourself → Copy User ID)
DISCORD_OWNER_ID=
# Comma-separated channel ids the bot should read (right-click channel → Copy Channel ID)
DISCORD_WATCH_CHANNELS=
